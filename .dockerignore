# Only source needed by the two build stages enters the build context.
**
!Dockerfile
!.dockerignore
!LICENSE
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!web/
!web/**
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
**/.env
**/.env.*
**/.npmrc
**/*.pem
**/*.key
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/.DS_Store
