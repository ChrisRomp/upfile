# Copy to .env. Origins must differ and have no path or trailing slash.
UPFILE_PUBLIC_ORIGIN=https://drop.example.com
UPFILE_ADMIN_ORIGIN=https://admin.example.com
UPFILE_AUTH_ISSUER=https://your-team.cloudflareaccess.com
UPFILE_AUTH_AUDIENCE=replace-with-admin-access-application-aud

# Only with the optional compose.npm-config.yaml override (see build networking):
# select a private npm userconfig outside this repository; defaults to ${HOME}/.npmrc.
# UPFILE_NPM_CONFIG_FILE=/absolute/path/to/private/.npmrc

# The token itself belongs only in this ignored file, never in an environment value.
UPFILE_TUNNEL_TOKEN_FILE=./deploy/tunnel-token

# Optional resource controls. Byte sizes are integers; durations are seconds.
UPFILE_CHUNK_BYTES=16777216
UPFILE_MAX_ACTIVE=8
UPFILE_MAX_RECORDS=100000
UPFILE_HEADROOM_BYTES=268435456
UPFILE_LEASE_SECONDS=300
UPFILE_SESSION_SECONDS=86400
UPFILE_RETENTION_SECONDS=86400

# Compose fixes UPFILE_DATA_DIR=/data, UPFILE_PUBLIC_ADDR=:8080 and
# UPFILE_ADMIN_ADDR=:8081. The bare binary also supports these variables.
# Set maximum file size and storage budget in the authenticated first-run UI.
# UPFILE_RETENTION_SECONDS never deletes completed files.
